// ============================================================
// Mahmoud Nagy Platform — Prisma Schema
// Postgres + Prisma. See /PROJECT_SPEC.md for the full rationale.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- Enums ----------------

enum Role {
  TEACHER
  ASSISTANT
  STUDENT
}

enum AttendanceMode {
  ONGROUND
  ONLINE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum GradingStatus {
  PENDING
  GRADED
}

enum ResolutionStatus {
  OPEN
  RESOLVED_PENDING_CONFIRM
  CONFIRMED_RESOLVED
  REOPENED
}

enum SenderType {
  STUDENT
  ASSISTANT
}

enum NotificationType {
  REPORT_READY
  DEADLINE_REMINDER
  GRADE_POSTED
  TICKET_REPLY
  TICKET_RESOLVED
  GENERAL
}

enum TicketMessageType {
  TEXT
  IMAGE
  PDF
  VIDEO
  AUDIO
  FILE
}

enum DelegationAction {
  ASSIGNED
  REASSIGNED
  REMOVED
  COMPLETED
  REOPENED
}

enum HomeworkGradingAction {
  GRADED
  EDITED
  REOPENED
}

enum ResourceSourceType {
  UPLOAD
  R2_EXISTING
}

// ---------------- Core: Users & Org structure ----------------

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  password String? // null until activated, e.g. first-login flows

  role Role

  // A Head of Assistants is NOT a separate role — it's an ASSISTANT who has been
  // promoted by the Teacher. They still do normal assistant work (grading, tickets,
  // group assignments, delegation targets) but also get admin-level access to
  // everything except creating/removing assistant accounts (stays Teacher-only).
  isHeadAssistant Boolean @default(false)

  // Teacher/Assistant hierarchy
  // For ASSISTANT users: who manages them.
  // - Before any assistant is promoted to Head, assistants report to the Teacher (managedByHeadId = null).
  // - Once at least one Head of Assistants exists, every non-head assistant must report to one (managedByHeadId set).
  // - Head Assistants themselves are not managed by another head (managedByHeadId stays null for them).
  managedByHeadId   String?
  managedByHead     User?   @relation("HeadManagesAssistants", fields: [managedByHeadId], references: [id])
  managedAssistants User[]  @relation("HeadManagesAssistants")

  // Per-assistant permission flags (only meaningful when role == ASSISTANT)
  // e.g. { "canGradeHomework": true, "canManageTickets": false, ... }
  permissions Json?

  // Student-only fields
  attendanceMode AttendanceMode?
  accessCode     String?         @unique // used by parents to look up a student read-only
  schoolId       String?
  school         School?         @relation(fields: [schoolId], references: [id])
  desiredYearId String?
  desiredYear   Year?           @relation("StudentDesiredYear", fields: [desiredYearId], references: [id])

  // Contact extras
  phone       String?
  // Parent contact — student chooses father only, mother only, or both at
  // registration. All optional since not every combination is provided.
  fatherName  String?
  fatherPhone String?
  motherName  String?
  motherPhone String?

  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations (as teacher/creator)
  yearsCreated   Year[]     @relation("YearTeacher")
  unitsCreated   Unit[]     @relation("UnitTeacher")
  materials      Material[] @relation("MaterialTeacher")
  videos         Video[]    @relation("VideoTeacher")
  questions      Question[] @relation("QuestionTeacher")
  quizzes        Quiz[]     @relation("QuizTeacher")
  sessionsHosted Session[]  @relation("SessionTeacher")
  tasksCreated   Task[]     @relation("TaskTeacher")

  // Relations (as student)
  groupMemberships        GroupMembership[]
  quizSubmissions         QuizSubmission[]
  submissions             Submission[]         @relation("StudentSubmissions")
  liveAnswers             LiveQuestionAnswer[] @relation("StudentLiveAnswers")
  attendanceRecords       SessionAttendance[]
  ticketsCreated          Ticket[]             @relation("TicketCreatedBy")
  ticketCategoriesCreated TicketCategory[]     @relation("TicketCategoryCreatedBy")

  // Relations (as assistant)
  groupAssignments      AssistantGroupAssignment[]
  delegationsReceived   Delegation[]               @relation("AssistantDelegations")
  delegationsAssigned   Delegation[]               @relation("DelegatedBy")
  gradedLiveAnswers     LiveQuestionAnswer[]       @relation("GradedBy")
  ticketsAssigned       Ticket[]                   @relation("TicketAssignedTo")
  ticketMessagesSent    TicketMessage[]
  groupChatMessagesSent GroupChatMessage[]
  groupChatReadStates   GroupChatReadState[]

  paperQuizSubmissionsGraded QuizSubmission[] @relation("PaperQuizGradedBy")

  notifications Notification[]
  pushTokens    PushToken[]

  homeworkFilesUploaded SubmissionFile[] @relation("SubmissionFileUploadedBy")

  correctedHomeworkFilesUploaded  CorrectedSubmissionFile[] @relation("CorrectedSubmissionFileUploadedBy")
  correctedPaperQuizFilesUploaded CorrectedPaperQuizFile[]  @relation("CorrectedPaperQuizUploadedBy")

  homeworkSubmissionsGraded Submission[] @relation("HomeworkGradedBy")

  homeworkGradingHistoryChanges HomeworkGradingHistory[] @relation("HomeworkGradingHistoryChangedBy")

  delegationHistoryFrom SubmissionDelegationHistory[] @relation("DelegationHistoryFromAssistant")

  delegationHistoryTo SubmissionDelegationHistory[] @relation("DelegationHistoryToAssistant")

  delegationHistoryChanged SubmissionDelegationHistory[] @relation("DelegationHistoryChangedBy")

  @@index([role])
  @@index([managedByHeadId])
}

model School {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  students  User[]
}

// ---------------- Academic structure ----------------

model Year {
  id        String   @id @default(uuid())
  name      String
  teacherId String
  teacher   User     @relation("YearTeacher", fields: [teacherId], references: [id])
  zoomLinks Json? // [{ title, link }]
  groups    Group[]
  units Unit []
  desiredStudents User[] @relation("StudentDesiredYear")

  createdAt DateTime @default(now())
}

model Group {
  id          String   @id @default(uuid())
  name        String
  yearId      String
  year        Year     @relation(fields: [yearId], references: [id])
  sessionLink String?
  createdAt   DateTime @default(now())

  members              GroupMembership[]
  assistantAssignments AssistantGroupAssignment[]
  sessions             Session[]
  tasks                TaskGroup[]
  quizzes              QuizGroup[]
  chatMessages         GroupChatMessage[]
  chatReadStates       GroupChatReadState[]
}

model GroupMembership {
  id        String @id @default(uuid())
  groupId   String
  group     Group  @relation(fields: [groupId], references: [id])
  studentId String
  student   User   @relation(fields: [studentId], references: [id])

  @@unique([groupId, studentId])
}

// Which assistant(s) handle which group(s) — drives ticket routing + delegation eligibility
model AssistantGroupAssignment {
  id          String @id @default(uuid())
  assistantId String
  assistant   User   @relation(fields: [assistantId], references: [id])
  groupId     String
  group       Group  @relation(fields: [groupId], references: [id])

  @@unique([assistantId, groupId])
}

model GroupChatMessage {
  id String @id @default(uuid())

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id])

  messageType TicketMessageType @default(TEXT)

  content String?

  attachmentUrl      String?
  attachmentName     String?
  attachmentMimeType String?
  attachmentSize     Int?
  audioDuration      Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId, createdAt])
  @@index([senderId])
}

model GroupChatReadState {
  id String @id @default(uuid())

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastReadAt DateTime @default(now())

  @@unique([groupId, userId])
  @@index([userId, lastReadAt])
}

model Unit {
  id        String   @id @default(uuid())
  name      String

  yearId    String?
  year      Year?    @relation(fields: [yearId], references: [id])

  teacherId String
  teacher   User     @relation("UnitTeacher", fields: [teacherId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  chapters  Chapter[]
  materials Material[] @relation("MaterialUnit")
  videos    Video[]    @relation("VideoUnit")

  @@index([yearId])
  @@index([name])
  @@index([teacherId])
}

model Chapter {
  id        String   @id @default(uuid())
  name      String
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id])
  createdAt DateTime @default(now())

  topics    Topic[]
  materials Material[] @relation("MaterialChapter")
  videos    Video[]    @relation("VideoChapter")
}

// NEW level in the hierarchy — most resources attach here
model Topic {
  id        String   @id @default(uuid())
  name      String
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id])
  createdAt DateTime @default(now())

  materials    Material[]      @relation("MaterialTopic")
  videos       Video[]         @relation("VideoTopic")
  // A question can tag multiple topics, and a topic can have many questions tagged
  // to it — this is a real many-to-many, unlike Material/Video's single-attachment.
  questionTags QuestionTopic[]
}

// ---------------- Resources ----------------
// Material/Video attach to exactly one of Topic/Chapter/Unit.
// App-layer validation enforces "exactly one of topicId/chapterId/unitId is set".

model Material {
  id      String @id @default(uuid())
  title   String
  fileUrl String

  sourceType ResourceSourceType @default(UPLOAD)

  topicId String?

  topic Topic? @relation("MaterialTopic", fields: [topicId], references: [id])

  chapterId String?

  chapter Chapter? @relation("MaterialChapter", fields: [chapterId], references: [id])

  unitId String?

  unit Unit? @relation("MaterialUnit", fields: [unitId], references: [id])

  teacherId String

  teacher User @relation("MaterialTeacher", fields: [teacherId], references: [id])

  createdAt DateTime @default(now())
}

model Video {
  id       String @id @default(uuid())
  title    String
  videoUrl String

  sourceType ResourceSourceType @default(UPLOAD)

  topicId String?

  topic Topic? @relation("VideoTopic", fields: [topicId], references: [id])

  chapterId String?

  chapter Chapter? @relation("VideoChapter", fields: [chapterId], references: [id])

  unitId String?

  unit Unit? @relation("VideoUnit", fields: [unitId], references: [id])

  teacherId String

  teacher User @relation("VideoTeacher", fields: [teacherId], references: [id])

  createdAt DateTime @default(now())

  checkpoints VideoCheckpoint[]
}

model VideoCheckpoint {
  id            String     @id @default(uuid())
  videoId       String
  video         Video      @relation(fields: [videoId], references: [id])
  timeInSeconds Int
  questions     Question[] @relation("CheckpointQuestions")
  createdAt     DateTime   @default(now())
}

enum QuestionType {
  MCQ
  WRITTEN
}

enum QuizType {
  MCQ
  PAPER
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model Question {
  id        String       @id @default(uuid())
  title     String       @default("Untitled question")
  reference String?
  type      QuestionType
  points    Float        @default(1)

  // Private R2 object key for the question PDF or image.
  questionFileUrl String

  // MCQ only: A, B, C, or D.
  correctAnswer String?

  // Written only. Optional but recommended.
  markschemeFileUrl String?

  teacherId String
  teacher   User   @relation("QuestionTeacher", fields: [teacherId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  topics      QuestionTopic[]
  checkpoints VideoCheckpoint[] @relation("CheckpointQuestions")
  quizzes     QuizQuestion[]

  @@index([teacherId])
  @@index([type])
  @@index([title])
}

// Join table for Question <-> Topic many-to-many tagging.
model QuestionTopic {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  topicId    String
  topic      Topic    @relation(fields: [topicId], references: [id])

  @@unique([questionId, topicId])
}

// ---------------- Quizzes ----------------

model Quiz {
  id          String  @id @default(uuid())
  title       String
  description String?

  type   QuizType   @default(MCQ)
  status QuizStatus @default(DRAFT)

  teacherId String
  teacher   User   @relation("QuizTeacher", fields: [teacherId], references: [id])

  // These @map values preserve the existing database column names.
  // Prisma code will use durationMinutes, startAt, and endAt.
  durationMinutes Int       @map("duration")
  startAt         DateTime? @map("startTime")
  endAt           DateTime? @map("endTime")

  // Stored for fast display and validation.
  // It will be recalculated from QuizQuestion.points.
  totalPoints Float @default(0)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  groups      QuizGroup[]
  questions   QuizQuestion[]
  submissions QuizSubmission[]

  @@index([teacherId])
  @@index([type])
  @@index([status])
  @@index([startAt])
  @@index([endAt])
}

model QuizGroup {
  id String @id @default(uuid())

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  groupId String
  group   Group  @relation(fields: [groupId], references: [id])

  assignedAt DateTime @default(now())

  @@unique([quizId, groupId])
  @@index([groupId])
}

model QuizQuestion {
  id String @id @default(uuid())

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id])

  // Controls the displayed question sequence.
  order Int @default(0)

  // A quiz may override the Question Bank default points.
  // Existing records can safely receive the default value.
  points Float @default(1)

  createdAt DateTime @default(now())

  @@unique([quizId, questionId])
  @@index([quizId, order])
  @@index([questionId])
}

model QuizSubmission {
  id String @id @default(uuid())

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation(fields: [studentId], references: [id])

  // MCQ format:
  // [
  //   {
  //     "questionId": "...",
  //     "answerText": "A"
  //   }
  // ]
  //
  // PAPER quizzes keep this as [] and use PaperQuizSubmissionFile.
  answers Json

  score       Float     @default(0)
  startedAt   DateTime  @default(now())
  expiresAt   DateTime?
  submittedAt DateTime?

  isSubmitted     Boolean @default(false)
  isAutoSubmitted Boolean @default(false)

  // PAPER quiz only:
  // Private R2 object key for the generated combined question paper.
  paperFileKey String?

  // Used to determine whether the generated paper is still current.
  paperGeneratedAt DateTime?

  // PAPER quiz grading state.
  isGraded Boolean @default(false)

  gradedAt   DateTime?
  gradedById String?
  gradedBy   User?     @relation("PaperQuizGradedBy", fields: [gradedById], references: [id])

  gradingComments String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  paperFiles          PaperQuizSubmissionFile[]
  correctedPaperFiles CorrectedPaperQuizFile[]

  @@unique([quizId, studentId])
  @@index([quizId])
  @@index([studentId])
  @@index([isSubmitted])
  @@index([isGraded])
}

model PaperQuizSubmissionFile {
  id String @id @default(uuid())

  submissionId String
  submission   QuizSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // Private Cloudflare R2 object key.
  objectKey String

  originalName String
  contentType  String
  size         Int?

  // Preserves the student's upload order.
  order Int @default(0)

  uploadedAt DateTime @default(now())

  @@index([submissionId, order])
}

model CorrectedPaperQuizFile {
  id String @id @default(uuid())

  submissionId String
  submission   QuizSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // Private Cloudflare R2 object key.
  objectKey String

  originalName String
  contentType  String
  size         Int?

  // Preserves the grader's upload order.
  order Int @default(0)

  uploadedById String
  uploadedBy   User   @relation("CorrectedPaperQuizUploadedBy", fields: [uploadedById], references: [id])

  uploadedAt DateTime @default(now())

  @@index([submissionId, order])
  @@index([uploadedById])
}

// In-class quick quizzes (teacher-graded groups of students, not question-bank based)
model InClassQuiz {
  id            String   @id @default(uuid())
  teacherId     String
  yearId        String
  groupId       String
  quizName      String
  date          DateTime
  gradeOutOf    Float
  studentGrades Json // [{ studentId, grade, percentage, letterGrade }]
  createdAt     DateTime @default(now())
}

// NOTE: QuizStopQuestion (a standalone "stop and answer" question type) was merged into
// Question + VideoCheckpoint per an explicit decision — the old system had built the same
// underlying feature twice. A "stop question" in a video is now just a Question attached
// to a VideoCheckpoint at a given timestamp; no separate model needed.

// ---------------- Sessions & Live Grading ----------------

model Session {
  id        String   @id @default(uuid())
  title     String
  date      DateTime @default(now())
  teacherId String
  teacher   User     @relation("SessionTeacher", fields: [teacherId], references: [id])
  yearId    String
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id])
  createdAt DateTime @default(now())

  attendance    SessionAttendance[]
  liveQuestions LiveQuestion[]
}

model SessionAttendance {
  id        String           @id @default(uuid())
  sessionId String
  session   Session          @relation(fields: [sessionId], references: [id])
  studentId String
  student   User             @relation(fields: [studentId], references: [id])
  status    AttendanceStatus @default(ABSENT)

  @@unique([sessionId, studentId])
}

// Requirement #3: teacher poses a question worth X marks during a session;
// student photographs their handwritten answer and uploads it; assistant grades it.
model LiveQuestion {
  id         String   @id @default(uuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id])
  prompt     String // question text or reference
  gradeOutOf Float
  createdAt  DateTime @default(now())

  answers LiveQuestionAnswer[]
}

model LiveQuestionAnswer {
  id             String        @id @default(uuid())
  liveQuestionId String
  liveQuestion   LiveQuestion  @relation(fields: [liveQuestionId], references: [id])
  studentId      String
  student        User          @relation("StudentLiveAnswers", fields: [studentId], references: [id])
  answerImageUrl String
  grade          Float?
  status         GradingStatus @default(PENDING)
  gradedById     String?
  gradedBy       User?         @relation("GradedBy", fields: [gradedById], references: [id])
  gradedAt       DateTime?
  submittedAt    DateTime      @default(now())

  @@unique([liveQuestionId, studentId])
}

// ---------------- Homework / Tasks / Delegation ----------------

model Task {
  id                  String   @id @default(uuid())
  title               String
  description         String?
  teacherId           String
  teacher             User     @relation("TaskTeacher", fields: [teacherId], references: [id])
  yearId              String
  deadline            DateTime
  gradeOutOf          Float
  // Optional PDF of the homework itself, uploaded by teacher/assistant (req: student
  // sees instructions + this file, if provided).
  taskFileUrl         String?
  // Editable after creation — teacher/assistant decides whether submissions are
  // still accepted after the deadline passes. Enforced server-side in submission.service.js.
  allowLateSubmission Boolean  @default(true)
  createdAt           DateTime @default(now())

  groups      TaskGroup[]
  submissions Submission[]
}

model TaskGroup {
  id      String @id @default(uuid())
  taskId  String
  task    Task   @relation(fields: [taskId], references: [id])
  groupId String
  group   Group  @relation(fields: [groupId], references: [id])

  @@unique([taskId, groupId])
}

model Submission {
  id String @id @default(uuid())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("StudentSubmissions", fields: [studentId], references: [id])

  // Legacy single-file field.
  // Keep temporarily so existing production records remain readable.
  fileUrl String?

  firstSubmittedAt DateTime @default(now())
  submittedAt      DateTime @default(now())
  lastModifiedAt   DateTime @default(now())

  lastModifiedAfterDeadline Boolean @default(false)

  grade Float?

  // Student-visible grading comments.
  comments String?

  gradedAt DateTime?

  gradedById String?
  gradedBy   User?   @relation("HomeworkGradedBy", fields: [gradedById], references: [id])

  // Legacy single corrected-file field.
  // Keep temporarily for existing records.
  correctedFileUrl String?

  files SubmissionFile[]

  correctedFiles CorrectedSubmissionFile[]

  delegation Delegation?

  delegationHistory SubmissionDelegationHistory[]

  gradingHistory HomeworkGradingHistory[]

  @@unique([taskId, studentId])
  @@index([taskId])
  @@index([studentId])
  @@index([gradedAt])
  @@index([gradedById])
  @@index([lastModifiedAfterDeadline])
}

model SubmissionFile {
  id String @id @default(uuid())

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  objectKey String

  originalName String
  contentType  String
  size         Int?

  order Int @default(0)

  uploadedAfterDeadline Boolean @default(false)

  uploadedById String
  uploadedBy   User   @relation("SubmissionFileUploadedBy", fields: [uploadedById], references: [id])

  uploadedAt DateTime @default(now())

  @@index([submissionId, order])
  @@index([uploadedById])
  @@index([uploadedAfterDeadline])
}

model CorrectedSubmissionFile {
  id String @id @default(uuid())

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  objectKey String

  originalName String
  contentType  String
  size         Int?

  order Int @default(0)

  uploadedById String
  uploadedBy   User   @relation("CorrectedSubmissionFileUploadedBy", fields: [uploadedById], references: [id])

  uploadedAt DateTime @default(now())

  @@index([submissionId, order])
  @@index([uploadedById])
}

// Requirement #9: delegate submitted papers to assistants for grading,
// with tracking per assistant per period (for salary calc).
model Delegation {
  id String @id @default(uuid())

  submissionId String     @unique
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  assistantId String
  assistant   User   @relation("AssistantDelegations", fields: [assistantId], references: [id])

  delegatedById String
  delegatedBy   User   @relation("DelegatedBy", fields: [delegatedById], references: [id])

  delegatedAt DateTime @default(now())

  completedAt DateTime?

  history SubmissionDelegationHistory[]

  @@index([assistantId, delegatedAt])
  @@index([completedAt])
}

model SubmissionDelegationHistory {
  id String @id @default(uuid())

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  delegationId String?
  delegation   Delegation? @relation(fields: [delegationId], references: [id], onDelete: SetNull)

  action DelegationAction

  fromAssistantId String?
  fromAssistant   User?   @relation("DelegationHistoryFromAssistant", fields: [fromAssistantId], references: [id])

  toAssistantId String?
  toAssistant   User?   @relation("DelegationHistoryToAssistant", fields: [toAssistantId], references: [id])

  changedById String
  changedBy   User   @relation("DelegationHistoryChangedBy", fields: [changedById], references: [id])

  reason String?

  createdAt DateTime @default(now())

  @@index([submissionId, createdAt])
  @@index([delegationId])
  @@index([fromAssistantId])
  @@index([toAssistantId])
  @@index([changedById])
  @@index([action])
}

model HomeworkGradingHistory {
  id String @id @default(uuid())

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  action HomeworkGradingAction

  previousGrade    Float?
  newGrade         Float?
  previousComments String?
  newComments      String?

  previousGradedAt DateTime?
  newGradedAt      DateTime?

  previousGradedById String?
  newGradedById      String?

  changedById String
  changedBy   User   @relation("HomeworkGradingHistoryChangedBy", fields: [changedById], references: [id])

  reason String?

  createdAt DateTime @default(now())

  @@index([submissionId, createdAt])
  @@index([changedById])
  @@index([action])
}

// ---------------- Tickets / Support ----------------

model TicketCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdById String?
  createdBy   User?    @relation("TicketCategoryCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  tickets Ticket[]
}

model Ticket {
  id          String         @id @default(uuid())
  createdById String
  createdBy   User           @relation("TicketCreatedBy", fields: [createdById], references: [id])
  categoryId  String
  category    TicketCategory @relation(fields: [categoryId], references: [id])
  subject     String

  // Auto-filled from the student's group's AssistantGroupAssignment
  assignedAssistantId String?
  assignedAssistant   User?   @relation("TicketAssignedTo", fields: [assignedAssistantId], references: [id])

  status                   ResolutionStatus @default(OPEN)
  studentConfirmedResolved Boolean? // null = not asked yet, true/false = student's answer

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages TicketMessage[]
}

model TicketMessage {
  id       String @id @default(uuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id])

  senderType SenderType

  messageType TicketMessageType @default(TEXT)

  content String?

  attachmentUrl      String?
  attachmentName     String?
  attachmentMimeType String?
  attachmentSize     Int?
  audioDuration      Int?

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([senderId])
}

// ---------------- Notifications ----------------

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  link      String? // deep link within the app
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expoToken String   @unique
  platform  String // "ios" | "android" | "web"
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
